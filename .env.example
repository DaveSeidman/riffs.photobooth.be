PORT=8000
STATUS_TIMEZONE=America/New_York
FAL_KEY=
FAL_MODEL=fal-ai/nano-banana-2/edit
FAL_INPUT_WIDTH=512
FAL_RESOLUTION=1K
FAL_THINKING_LEVEL=high
CAMPAIGN_THINKING_LEVEL=minimal
FAL_TIMEOUT_MS=30000
DATA_DIR=.
ALLOWED_ORIGINS=http://localhost:8080
STYLED_LABEL=Styled Portrait
UPLOAD_MAX_MB=15

# Generate a different second Lunar treatment after the selected portrait returns.
PRINT_PREPARE_STRIPS=false
PRINT_AUTO_SUBMIT=false
PRINT_SERVER_URL=http://localhost:9000/print
PRINT_SERVER_TOKEN=
# Required before automatic printing. Keep blank until the event date is confirmed.
CONFERENCE_DATE=
CONFERENCE_LOCATION=in New York

# Classic filters replace failed or slow AI results. Deadline = 2x normal.
LOCAL_FALLBACK_ENABLED=true
AI_NORMAL_DURATION_MS=17000

# Allow the interlocking portrait to finish without a local filter substitute.
CAMPAIGN_TIMEOUT_MS=120000

# Public HTTPS backend origin used by photo QR codes (no trailing slash).
PUBLIC_PHOTO_ORIGIN=

# Private review gallery access code (never set as a VITE variable).
REVIEW_TOKEN=
